# GEMINI_API_KEY: Required for Gemini AI agent panel (optional for extraction tools).
GEMINI_API_KEY=

# APP_URL: Public URL of this deployment.
APP_URL=

# Playwright (long-running hosts only; ignored / disabled on Vercel)
ENABLE_PLAYWRIGHT=1
# DISABLE_PLAYWRIGHT=1
# PLAYWRIGHT_HEADED=0

# CDP attach to an existing Chrome (chrome-devtools-mcp --browserUrl / --wsEndpoint)
# Launch Chrome with: google-chrome --remote-debugging-port=9222
# CDP_BROWSER_URL=http://127.0.0.1:9222
# CDP_WS_ENDPOINT=
# Alias: PW_BROWSER_URL / PW_WS_ENDPOINT

# Persistent Chrome profile (browser-ai-bridge style logins)
# PW_USER_DATA_DIR=~/.open-browser-mcp/chrome-profile
# CHROME_USER_DATA_DIR=
# CHROME_EXECUTABLE_PATH=

# Optional mailbox agent id
# MAIL_AGENT_ID=thang
