# Open Browser MCP Controller v4.1
# Gemini (optional — AI Agent tab + extract_llm). Auto-enables when set.
GEMINI_API_KEY=

# Search cascade (auto): Tavily → Jina → Wikipedia → DuckDuckGo
# Free keys — paste when ready; code falls back gracefully without them.
TAVILY_API_KEY=
JINA_API_KEY=
# SEARCH_PROVIDER=auto|tavily|jina|wikipedia|duckduckgo

# Durable mailbox + change-store on Vercel (Upstash Redis free)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Tool profiles / caps (github-mcp + playwright-mcp style)
# Profiles: minimal | extract | browser | full | devops | agents
OBMC_PROFILE=full
# Or explicit caps CSV: core,browser,extract,playwright,mail,ai,network,storage,devtools,vision,pdf,meta
# OBMC_CAPS=extract,meta,mail
# MCP_EXCLUDE_TOOLS=ai_chat,pw_pdf
# MCP_TOOLS=extract_readable,extract_map

# HTTP extraction
OBMC_USER_AGENT=
OBMC_PROXY=
OBMC_PROXY_BYPASS=
OBMC_ALLOWED_DOMAINS=
OBMC_BLOCKED_DOMAINS=
OBMC_CACHE=1
OBMC_CACHE_TTL=120
OBMC_RATE_LIMIT=60
OBMC_MAX_OUTPUT=100000
OBMC_CONTENT_BOUNDARIES=0
OBMC_IGNORE_HTTPS_ERRORS=0
OBMC_STEALTHISH=0

# Persistence (Docker/local file; Redis preferred on Vercel)
MAIL_PERSIST_PATH=./data/mailbox.json
OBMC_CHANGE_STORE=./data/change-store.json
OBMC_DOWNLOAD_DIR=./data/downloads
OBMC_OUTPUT_DIR=./data/output

# Playwright / CDP (Docker/local only — ignored on Vercel)
# ENABLE_PLAYWRIGHT=1
# DISABLE_PLAYWRIGHT=0
# PLAYWRIGHT_HEADED=0
# PLAYWRIGHT_ENGINE=playwright|patchright
# OBMC_VIDEO=1
# CDP_BROWSER_URL=http://127.0.0.1:9222
# CDP_WS_ENDPOINT=
# PW_USER_DATA_DIR=
# CHROME_EXECUTABLE_PATH=

# App
# APP_URL=https://open-browser-mcp-controller-ozvietnam.vercel.app
# PORT=3000
