{
  "name": "open-browser-mcp-controller",
  "private": true,
  "version": "3.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "build": "vite build",
    "build:api": "esbuild server.ts --bundle --platform=node --format=esm --outfile=api/index.mjs --packages=bundle --banner:js=\"import { createRequire as __cr } from 'module'; const require = __cr(import.meta.url);\" --external:playwright --external:vite --external:fsevents",
    "preview": "vite preview",
    "start": "NODE_ENV=production tsx server.ts",
    "mcp:stdio": "tsx scripts/mcp-stdio.ts",
    "smoke": "tsx scripts/smoke-extract.ts",
    "clean": "rm -rf dist",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "@google/genai": "^1.30.0",
    "@modelcontextprotocol/sdk": "^1.22.0",
    "cheerio": "^1.1.2",
    "cors": "^2.8.5",
    "dotenv": "^16.6.1",
    "express": "^4.21.2",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zod": "^3.25.76"
  },
  "optionalDependencies": {
    "playwright": "^1.55.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.13",
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@vitejs/plugin-react": "^4.7.0",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.25.0",
    "tailwindcss": "^4.1.13",
    "tsx": "^4.20.5",
    "typescript": "^5.8.3",
    "vite": "^6.3.5"
  },
  "engines": {
    "node": ">=20"
  }
}
