# Token MCP — khuyến nghị DÙNG CHUNG token hiện tại của team (file ~/Downloads/obmc-mcp/mcp-auth.token)
MCP_AUTH_TOKEN=dán-token-vào-đây

# Pool key Gemini (tùy chọn trên VPS — lớp 1 đã chạy ở Vercel; đặt nếu muốn VPS tự hỏi đáp độc lập)
# GEMINI_API_KEYS=key1,key2,key3

# Model mặc định cho /api/prompt/run trên VPS (bỏ trống = cascade)
# GEMINI_MODEL=
